# Moonshot AI (Kimi) API credentials
# Get a key at https://platform.kimi.ai
# Note: new accounts start at Tier 0 (max organization concurrency: 1,
# 3 requests/min) until you cumulative-recharge $10+. See --model openrouter/...
# below for a way around this that doesn't depend on Moonshot's own tier.
MOONSHOT_API_KEY=your-key-here

# Optional: override if using a proxy/mirror endpoint
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Alternative: OpenRouter (routes to Kimi K2.6 via openrouter/moonshotai/kimi-k2.6)
# Get a key at https://openrouter.ai/keys -- needs a small credit top-up.
# Rate limits scale with your credit balance instead of Moonshot's fixed
# account tiers, so this is usually the faster path to real concurrency.
OPENROUTER_API_KEY=your-key-here
